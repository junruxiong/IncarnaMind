{
  "name": "incarnamind",
  "productName": "IncarnaMind",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first notebook that answers Questions from your own Documents.",
  "license": "Apache-2.0",
  "author": "Junru Xiong",
  "homepage": "https://github.com/junruxiong/IncarnaMind",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "electron-vite build && playwright test"
  },
  "dependencies": {
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-collaboration": "3.31.4",
    "@tiptap/extensions": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@tiptap/y-tiptap": "3.0.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.5.1",
    "electron-vite": "5.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "7.3.7",
    "vitest": "5.0.3"
  }
}
