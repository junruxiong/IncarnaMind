    "zh-hant": {
      "lines": [
        {
          "text": "圖書館開放時間調整通知",
          "quad": [0.1034, 0.0748, 0.3688, 0.0748, 0.3688, 0.0915, 0.1034, 0.0915],
          "unsure": []
        },
        {
          "text": "自十月一日起，本館週一至週五開放時間調整為上午九時至晚上九時。",
          "quad": [0.104, 0.1171, 0.6741, 0.1176, 0.6735, 0.1325, 0.104, 0.1317],
          "unsure": []
        },
        {
          "text": "週六及週日開放時間為上午十時至下午六時，國定假日休館。",
          "quad": [0.1028, 0.1364, 0.5985, 0.1368, 0.5985, 0.1513, 0.1028, 0.1509],
          "unsure": []
        },
        {
          "text": "讀者如需延長借閱期限，請於到期前透過網站或櫃檯辦理續借。",
          "quad": [0.1022, 0.156, 0.6179, 0.156, 0.6179, 0.171, 0.1022, 0.171],
          "unsure": []
        }
      ]
    },
    "en-small": {
      "lines": [
        {
          "text": "MEMORANDUM",
          "quad": [0.1064, 0.0727, 0.2485, 0.074, 0.2479, 0.0911, 0.1064, 0.0902],
          "unsure": []
        },
        {
          "text": "To:All project leads From: Finance office Date: 14 May 2025",
          "quad": [0.1052, 0.1018, 0.5405, 0.1043, 0.5405, 0.1197, 0.1052, 0.1171],
          "unsure": ["To:All", "office"]
        },
        {
          "text": "Subject: Travel claims for the second quarter",
          "quad": [0.1058, 0.1176, 0.4099, 0.1201, 0.4093, 0.1342, 0.1058, 0.1317],
          "unsure": ["quarter"]
        },
        {
          "text": "Claims for travel between April and June must reach the finance office by 5 July.",
          "quad": [0.1052, 0.1437, 0.6445, 0.1488, 0.6439, 0.1646, 0.1052, 0.1595],
          "unsure": ["between", "April", "office"]
        },
        {
          "text": "Attach a receipt for every item over25 pounds, and the booking confirmation for",
          "quad": [0.1046, 0.1599, 0.6445, 0.1637, 0.6439, 0.1791, 0.1046, 0.1753],
          "unsure": ["Attach"]
        },
        {
          "text": "rail and air fares. Claims without receipts will be returned unpaid.",
          "quad": [0.1034, 0.1757, 0.5405, 0.1791, 0.5405, 0.1945, 0.1028, 0.1911],
          "unsure": ["rail", "returned"]
        },
        {
          "text": "Mileage is paid at 45 pence a mile for the first 10,000 miles in the tax year,",
          "quad": [0.1034, 0.1911, 0.6076, 0.195, 0.6076, 0.2108, 0.1034, 0.2069],
          "unsure": ["for"]
        },
        {
          "text": "and at 25 pence a mile after that. Taxis are paid only where no train or bus",
          "quad": [0.104, 0.2074, 0.6058, 0.2112, 0.6058, 0.2257, 0.104, 0.2219],
          "unsure": []
        },
        {
          "text": "runs within an hour of the journey, or where the claimant carries equipment.",
          "quad": [0.104, 0.2227, 0.6119, 0.227, 0.6119, 0.2416, 0.1034, 0.2377],
          "unsure": ["within"]
        },
        {
          "text": "Questions about a claim should go to the finance ofice, room 2.14, extension 4471.",
          "quad": [0.1028, 0.2381, 0.6657, 0.2416, 0.6657, 0.2574, 0.1028, 0.254],
          "unsure": ["ofice,"]
        }
      ]
    },
    "zh-light": {
      "lines": [
        {
          "text": "关于召开年度总结会议的通知",
          "quad": [0.0937, 0.0778, 0.3809, 0.0752, 0.3815, 0.0945, 0.0943, 0.0971],
          "unsure": []
        },
        {
          "text": "各部门：",
          "quad": [0.0931, 0.115, 0.1626, 0.115, 0.1626, 0.133, 0.0931, 0.133],
          "unsure": []
        },
        {
          "text": "公司定于十二月二十日下午两点在三楼会议室召开年度总结会议。",
          "quad": [0.0943, 0.1342, 0.5816, 0.1295, 0.5822, 0.1458, 0.0949, 0.1505],
          "unsure": []
        },
        {
          "text": "请各部门负责人准备本部门全年工作总结，时间控制在十分钟以内。",
          "quad": [0.0943, 0.1509, 0.6022, 0.1462, 0.6028, 0.1625, 0.0949, 0.1672],
          "unsure": []
        },
        {
          "text": "会议材料请于十二月十八日前发送至行政部邮箱，逾期不再安排发言。",
          "quad": [0.0961, 0.1693, 0.6215, 0.1646, 0.6221, 0.1804, 0.0961, 0.1847],
          "unsure": ["，"]
        },
        {
          "text": "如有特殊情况不能参加·请提前向行政部请假，并指定一名代表出席",
          "quad": [0.0961, 0.1868, 0.6076, 0.1826, 0.6082, 0.1979, 0.0961, 0.2022],
          "unsure": ["·", "，"]
        },
        {
          "text": "会后将安排部门之间的交流，请各位预留一个小时的时间。",
